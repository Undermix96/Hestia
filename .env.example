# Hestia configuration. Copy to .env and edit; every value is optional.
#
# Variables used by docker compose itself (interpolation in docker-compose.yml)
# ---------------------------------------------------------------------------
# Image tag to run, e.g. 0.1.0, v0.1.0 or 0.1 (default: latest).
# Do not set HESTIA_VERSION here: the version is baked into each image.
# HESTIA_TAG=latest
# Host port where the dashboard is published (default: 8080).
# HESTIA_PORT=8080

# Variables passed to the backend container (env_file)
# ---------------------------------------------------------------------------
# Not used yet in M0: they will be read starting from milestone M2.
# Environment variables take precedence over the configuration made in the UI.
#
# Home Assistant URL as seen from the container, and a long-lived access token
# (an admin token is needed for schedule editing and templates).
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
#
# Optional InfluxDB 2.x history source.
# INFLUX_URL=http://influxdb:8086
# INFLUX_TOKEN=
# INFLUX_ORG=
# INFLUX_BUCKET=
